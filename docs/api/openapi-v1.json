    "/projects/{projectId}/conflicts/{conflictId}/resolve": {
      "post": {
        "summary": "Resolve a conflict for the session user: keep_both, choose_current or reject. choose_incoming answers 409 approve_in_app.",
        "operationId": "resolve_conflict",
        "tags": [
          "v1"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "$ref": "#/components/parameters/conflictId"
          }
        ],
        "security": [
          {
            "bearer": [
              "transfers:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "choice",
                  "revision"
                ],
                "properties": {
                  "choice": {
                    "type": "string",
                    "enum": [
                      "keep_both",
                      "choose_current",
                      "choose_incoming",
                      "reject"
                    ]
                  },
                  "revision": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/projects/{projectId}/premiere/returns": {
      "post": {
        "summary": "C-3: send the Premiere edit back as per-panel proposals (never applied automatically).",
        "operationId": "premiere_return",
        "tags": [
          "v1"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          }
        ],
        "security": [
          {
            "bearer": [
              "transfers:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Manifest v1, adapter.id = adobe-premiere-uxp"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Samme retur allerede mottatt (Idempotent-Replayed)"
          },
          "201": {
            "description": "Forslag laget",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "returnId": {
                      "type": "string"
                    },
                    "proposals": {
                      "type": "integer"
                    },
                    "conflicts": {
                      "type": "integer"
                    },
                    "missing": {
                      "type": "integer"
                    },
                    "unknown": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Feil prosjekt"
          },
          "404": {
            "description": "Produksjonen finnes ikke"
          },
          "413": {
            "description": "For stort"
          },
          "422": {
            "description": "Ugyldig manifest"
          }
        }
      }
    },
    "/projects/{projectId}/audition/plan": {
      "get": {
        "summary": "C-6: audio plan for one scene occurrence or panel for Adobe Audition (read only).",
        "operationId": "audition_plan",
        "tags": [
          "v1"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "$ref": "#/components/parameters/occurrenceId"
          },
          {
            "$ref": "#/components/parameters/panelId"
          }
        ],
        "security": [
          {
            "bearer": [
              "manifest:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Plan with clips (asset/variant/version IDs), roles and panel/line markers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request"
          },
          "404": {
            "description": "not_found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://pentoglass.com/koble",
            "tokenUrl": "https://pentoglass.com/api/v1/oauth/token",
            "refreshUrl": "https://pentoglass.com/api/v1/oauth/token",
            "scopes": {
              "project:read": "project:read",
              "manifest:read": "manifest:read",
              "assets:read": "assets:read",
              "panels:read": "panels:read",
              "transfers:write": "transfers:write",
              "conflicts:read": "conflicts:read",
              "notes:write": "notes:write"
            }
          }
        }
      }
    },
    "parameters": {
      "projectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "assetId": {
        "name": "assetId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "transferId": {
        "name": "transferId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "index": {
        "name": "index",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        }
      },
      "versionId": {
        "name": "versionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "conflictId": {
        "name": "conflictId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "occurrenceId": {
        "name": "occurrenceId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "panelId": {
        "name": "panelId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "required": [
          "grant_type"
        ],
        "properties": {
          "grant_type": {
            "enum": [
              "authorization_code",
              "refresh_token",
              "urn:ietf:params:oauth:grant-type:device_code"
            ]
          },
          "code": {
            "type": "string"
          },
          "code_verifier": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "device_code": {
            "type": "string"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "scope",
          "project_id"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer"
          },
          "refresh_token": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DeviceResponse": {
        "type": "object",
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "expires_in",
          "interval"
        ],
        "properties": {
          "device_code": {
            "type": "string"
          },
          "user_code": {
            "type": "string"
          },
          "verification_uri": {
            "type": "string"
          },
          "verification_uri_complete": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "interval": {
            "type": "integer"
          }
        }
      },
      "ReserveRequest": {
        "type": "object",
        "required": [
          "fileName",
          "byteSize",
          "sha256",
          "target",
          "base"
        ],
        "properties": {
          "fileName": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target": {
            "type": "object",
            "required": [
              "assetId",
              "variantId"
            ],
            "properties": {
              "assetId": {
                "type": "string"
              },
              "variantId": {
                "type": "string"
              }
            }
          },
          "base": {
            "type": "object",
            "properties": {
              "versionId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "Transfer": {
        "type": "object",
        "required": [
          "id",
          "status",
          "chunkCount",
          "missingChunks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "reserved",
              "uploading",
              "received",
              "candidate",
              "rejected",
              "failed"
            ]
          },
          "fileName": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "chunkCount": {
            "type": "integer"
          },
          "missingChunks": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "candidateVersionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "conflictId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": [
          "manifestVersion",
          "createdAt",
          "projectId",
          "frameRate",
          "sampleRate",
          "sourceApp",
          "adapter",
          "items"
        ],
        "additionalProperties": true,
        "properties": {
          "manifestVersion": {
            "const": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "projectId": {
            "type": "string"
          },
          "frameRate": {
            "type": "object",
            "required": [
              "num",
              "den"
            ],
            "properties": {
              "num": {
                "type": "integer"
              },
              "den": {
                "type": "integer"
              }
            }
          },
          "sampleRate": {
            "type": "integer"
          },
          "sourceApp": {
            "type": "object"
          },
          "adapter": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
