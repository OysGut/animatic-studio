{
  "openapi": "3.1.0",
  "info": {
    "title": "From Pen to Glass – Creative Connectors API",
    "version": "1.0.0",
    "description": "C-0. Kortlivede bearer-tokens per prosjekt og scope (OAuth 2.0 Authorization Code + PKCE S256, eller enhetsflyt). Ingen hemmeligheter i plugins. Alle svar har Cache-Control: no-store."
  },
