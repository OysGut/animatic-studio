                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
