{
  "manifestVersion": 5,
  "id": "com.pentoglass.photoshop",
  "name": "From Pen to Glass",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "27.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ptgPanel",
      "label": { "default": "Pen to Glass", "nb": "Pen to Glass" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 2000, "height": 4000 },
      "preferredDockedSize": { "width": 300, "height": 520 },
      "preferredFloatingSize": { "width": 340, "height": 560 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "network": { "domains": ["https://pentoglass.com"] },
    "launchProcess": { "schemes": ["https"], "extensions": [] },
    "localFileSystem": "plugin",
    "clipboard": "read"
  }
}
